  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.20.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^181.0.0",
    "resend": "^6.30.0"
  },
  "devDependencies": {
